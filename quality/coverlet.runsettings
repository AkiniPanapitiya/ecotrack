<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings used by dotnet test (XPlat Code Coverage collector = Coverlet).
  cobertura  -> read by ReportGenerator (HTML report, badges, quality gate)
  opencover  -> read by SonarQube (coverage on the dashboard)
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <Exclude>[*.Tests]*,[xunit.*]*,[Moq]*</Exclude>
          <ExcludeByFile>**/Program.cs,**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
