<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="EcoTrack Sprint 4 Performance Test Plan" enabled="true">
      <stringProp name="TestPlan.comments">Performance & Load Test Suite for Sprint 4 Logistics, Marketplace & Analytics Services</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="LOGISTICS_HOST" elementType="Argument">
            <stringProp name="Argument.name">LOGISTICS_HOST</stringProp>
            <stringProp name="Argument.value">localhost</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LOGISTICS_PORT" elementType="Argument">
            <stringProp name="Argument.name">LOGISTICS_PORT</stringProp>
            <stringProp name="Argument.value">5002</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MARKETPLACE_HOST" elementType="Argument">
            <stringProp name="Argument.name">MARKETPLACE_HOST</stringProp>
            <stringProp name="Argument.value">localhost</stringProp>
            <stringProp name="Argument.metadata">=</stringParam>
          </elementProp>
          <elementProp name="MARKETPLACE_PORT" elementType="Argument">
            <stringProp name="Argument.name">MARKETPLACE_PORT</stringProp>
            <stringProp name="Argument.value">5003</stringProp>
            <stringProp name="Argument.metadata">=</stringParam>
          </elementProp>
          <elementProp name="ANALYTICS_HOST" elementType="Argument">
            <stringProp name="Argument.name">ANALYTICS_HOST</stringProp>
            <stringProp name="Argument.value">localhost</stringProp>
            <stringProp name="Argument.metadata">=</stringParam>
          </elementProp>
          <elementProp name="ANALYTICS_PORT" elementType="Argument">
            <stringProp name="Argument.name">ANALYTICS_PORT</stringProp>
            <stringProp name="Argument.value">5004</stringParam>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <!-- Thread Group: Baseline Load -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Baseline Load" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">100</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">10</stringProp>
        <stringProp name="ThreadGroup.ramp_time">60</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <!-- Thread Group: Ramp-Up to Peak -->
        <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Ramp-Up to Peak" enabled="true">
          <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
          <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
            <boolProp name="LoopController.continue_forever">false</boolProp>
            <stringProp name="LoopController.loops">100</stringProp>
          </elementProp>
          <stringProp name="ThreadGroup.num_threads">50</stringProp>
          <stringProp name="ThreadGroup.ramp_time">120</stringProp>
          <boolProp name="ThreadGroup.scheduler">false</boolProp>
        </ThreadGroup>
        <hashTree>
          <!-- Thread Group: Spike -->
          <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Short Spike" enabled="true">
            <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
            <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
              <boolProp name="LoopController.continue_forever">false</boolProp>
              <stringProp name="LoopController.loops">50</stringProp>
            </elementProp>
            <stringProp name="ThreadGroup.num_threads">100</stringProp>
            <stringProp name="ThreadGroup.ramp_time">10</stringProp>
            <boolProp name="ThreadGroup.scheduler">false</boolProp>
          </ThreadGroup>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>